[node name="FieldScene" type="Node2D"]
script = ExtResource( 1 )

[node name="FieldBackground" type="Sprite2D" parent="."]
texture = preload("res://assets/backgrounds/field_bg.png")
position = Vector2(640, 360)

[node name="Player" type="Sprite2D" parent="."]
texture = preload("res://assets/characters/lilia_idle.png")
position = Vector2(640, 360)

[node name="Camera" type="Camera2D" parent="Player"]
current = true

[node name="UILayer" type="CanvasLayer" parent="."]

[node name="InteractPrompt" type="Label" parent="UILayer"]
text = "[E] 상호작용"
position = Vector2(600, 700)
visible = false


func _ready():
    setup_buttons()

func setup_buttons():
    $ExploreButton.connect("pressed", self, "_on_ExploreButton_pressed")
    $BackButton.connect("pressed", self, "_on_BackButton_pressed")

func _on_ExploreButton_pressed():
    show_popup("탐험을 시작합니다.")

func _on_BackButton_pressed():
    go_to_home_scene()

func show_popup(text):
    var popup = AcceptDialog.new()
    popup.dialog_text = text
    add_child(popup)
    popup.popup_centered()

func go_to_home_scene():
    var new_scene = load("res://HomeScene.tscn").instantiate()
    get_tree().root.add_child(new_scene)
    queue_free()
